{#
| Variable               | Type     | Description                      |
|------------------------|----------|----------------------------------|
| component.items        | object[] | Trust cards                      |
| component.items[].icon | string   | Salla icon class (sicon-*)       |
| component.items[].title| string   | Card title                       |
| component.items[].text | string   | Card text                        |
| position               | int      | Sorting number start from zero   |
#}
<section component-id="{{ componentId }}" data-testid="montre-trust" class="montre-section">
    <div class="montre-container montre-trust">
        {% for item in component.items %}
            <div class="montre-trust__card">
                {% if item.icon %}<i class="{{ item.icon }}" aria-hidden="true"></i>{% endif %}
                <div>
                    <h3>{{ item.title }}</h3>
                    <p>{{ item.text }}</p>
                </div>
            </div>
        {% endfor %}
    </div>
</section>
